# Copy to .env.local and fill in.

# Supabase (from `supabase status` in ../petalprogress-db, or the project dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# petalprogress-sms endpoints for checkout, preferences, pause/resume, billing portal
VITE_TEXTS_API_URL=

# true = click through the texts flow with no Supabase, Stripe or Twilio
VITE_TEXTS_DEMO=false

# Which pages ship: "texts" (the guided-journal pages only; the default) or
# "full" (adds the hidden mandala/gallery/admin pages). To work on the hidden
# pages run: VITE_APP_SURFACE=full npm run dev
# VITE_APP_SURFACE=
